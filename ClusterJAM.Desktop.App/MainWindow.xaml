<Window x:Class="ClusterJAM.Desktop.App.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:infrastructure="clr-namespace:ClusterJAM.Desktop.App.Infrastructure"
                Title="Cluster JAM · Administración" Width="1120" Height="780"
                MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen"
                Background="#F3F5F8" FontFamily="Segoe UI" Foreground="#172338">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#C4CCD6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,16" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#C4CCD6" />
            <Setter Property="Margin" Value="0,6,0,16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#172338" />
            <Setter Property="BorderBrush" Value="#C4CCD6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#174A40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#174A40" />
        </Style>
    </Window.Resources>
    <Grid Background="#F3F5F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#142536" Padding="30,36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="CLUSTER JAM" FontSize="26" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="ADMINISTRACIÓN" Margin="0,8,0,0" Foreground="#8DC6B7" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Administra la operación" Foreground="White" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Pedidos, catálogo, inventario, personalización y reportes desde tu escritorio."
                                          Margin="0,18,0,0" Foreground="#C0CBD5" FontSize="15" LineHeight="25" />
                    <Border BorderBrush="#425364" BorderThickness="1" Padding="16" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="Acceso restringido" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="Tu cuenta debe tener permisos de administrador."
                                                  Margin="0,8,0,0" Foreground="#C0CBD5" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Cluster JAM · Windows" Foreground="#A6B5C2" FontSize="12" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="40,36" MaxWidth="560" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Margin="0,12,0,26" Foreground="#526175" FontSize="14" />
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <StackPanel Visibility="{Binding ShowEmail, Converter={StaticResource VisibleWhenTrue}}">
                            <Label Content="Correo de acceso" Target="{Binding ElementName=EmailInput}" Padding="0" />
                            <TextBox x:Name="EmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                              MaxLength="254" AutomationProperties.Name="Correo de acceso" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowCode, Converter={StaticResource VisibleWhenTrue}}">
                            <Label Content="Código de seis dígitos" Target="{Binding ElementName=CodeInput}" Padding="0" />
                            <TextBox x:Name="CodeInput" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                              MaxLength="6" AutomationProperties.Name="Código de seis dígitos" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowPassword, Converter={StaticResource VisibleWhenTrue}}">
                            <Label Content="Contraseña" Target="{Binding ElementName=PasswordInput}" Padding="0" />
                            <PasswordBox x:Name="PasswordInput" infrastructure:PasswordBinding.IsEnabled="True"
                                                      infrastructure:PasswordBinding.Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="Contraseña" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowPasswordConfirmation, Converter={StaticResource VisibleWhenTrue}}">
                            <Label Content="Confirmar contraseña" Target="{Binding ElementName=ConfirmationInput}" Padding="0" />
                            <PasswordBox x:Name="ConfirmationInput"
                                                      infrastructure:PasswordBinding.IsEnabled="True"
                                                      infrastructure:PasswordBinding.Value="{Binding PasswordConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="Confirmar contraseña" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="White" BorderBrush="#DDE3E9" BorderThickness="1" Padding="20" Margin="0,0,0,20"
                                    Visibility="{Binding IsRestricted, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel>
                            <TextBlock Text="No puedes abrir el panel" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SignedInEmail}" Margin="0,12,0,0" />
                            <TextBlock Text="Las compras y la personalización de clientes se realizan desde Android."
                                                  Foreground="#526175" Margin="0,10,0,0" />
                            <Button Content="Usar otra cuenta" Command="{Binding LogoutCommand}" Margin="0,20,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#DDE3E9" BorderThickness="1" Padding="20" Margin="0,0,0,20"
                                    Visibility="{Binding IsAdministration, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel>
                            <TextBlock Text="Cuenta de administrador" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SignedInEmail}" Margin="0,12,0,0" />
                            <TextBlock Text="La base de autenticación está lista. Los módulos de operación se integrarán en la siguiente etapa."
                                                  Foreground="#526175" Margin="0,10,0,20" />
                            <Button Content="Verificar sesión y permisos" Command="{Binding CheckSessionCommand}" />
                            <Button Content="Cerrar sesión" Command="{Binding LogoutCommand}" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                                              Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}"
                                              AutomationProperties.Name="Procesando solicitud" />
                    <TextBlock Text="{Binding Message}" Margin="0,0,0,16" FontSize="14"
                                          AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Foreground" Value="#17654E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#A12828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{Binding SubmitLabel}" Command="{Binding SubmitCommand}"
                                    Style="{StaticResource PrimaryButton}" IsDefault="True"
                                    Visibility="{Binding ShowSubmit, Converter={StaticResource VisibleWhenTrue}}" />
                    <StackPanel Visibility="{Binding IsLogin, Converter={StaticResource VisibleWhenTrue}}">
                        <Button Content="Recuperar contraseña" Command="{Binding NavigateCommand}" CommandParameter="RequestRecovery" />
                    </StackPanel>
                    <Button Content="Ya tengo un código" Command="{Binding NavigateCommand}" CommandParameter="ResetPassword"
                                    Visibility="{Binding IsRecovery, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button Content="Solicitar otro código de recuperación" Command="{Binding ResendCommand}"
                                    Visibility="{Binding IsReset, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button Content="Volver al acceso" Command="{Binding NavigateCommand}" CommandParameter="Login"
                                    Visibility="{Binding ShowBack, Converter={StaticResource VisibleWhenTrue}}" />
                    <TextBlock Text="La sesión permanece en este equipo solo mientras la aplicación está abierta."
                                          Foreground="#64748B" FontSize="12" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
